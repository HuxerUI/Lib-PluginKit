include_guard(GLOBAL)

# SDK archives remain untouched. Only the consuming build's framework links are redirected.
function(_hpk_android_rebind_directory directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        if (target STREQUAL "hpk_runtime")
            continue()
        endif()
        foreach(property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(links ${target} ${property})
            if (links)
                string(REPLACE "HuxerUI::huxerui_static" "hpk_runtime" links "${links}")
                string(REPLACE "HuxerUI::huxerui" "hpk_runtime" links "${links}")
                set_property(TARGET ${target} PROPERTY ${property} "${links}")
            endif()
        endforeach()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        _hpk_android_rebind_directory("${child}")
    endforeach()
endfunction()

function(_hpk_android_rebind_all)
    _hpk_android_rebind_directory("${CMAKE_SOURCE_DIR}")
endfunction()

function(_hpk_android_package_plan)
    get_property(targets GLOBAL PROPERTY HPK_ANDROID_PACKAGE_TARGETS)
    set(entries)
    foreach(target IN LISTS targets)
        if(entries)
            string(APPEND entries ",")
        endif()
        string(APPEND entries "\"${target}-package\"")
    endforeach()
    string(REPLACE "\\" "\\\\" directory "${CMAKE_BINARY_DIR}")
    string(REPLACE "\"" "\\\"" directory "${directory}")
    file(GENERATE OUTPUT "${HUXERUI_ANDROID_APP_INTEGRATION_ROOT}/${ANDROID_ABI}/pluginkit.json"
        CONTENT "{\"schema\":1,\"build_directory\":\"${directory}\",\"targets\":[${entries}]}\n")
endfunction()

function(_hpk_android_runtime)
    if (TARGET hpk_runtime)
        return()
    endif()
    if (NOT ANDROID_STL STREQUAL "c++_shared")
        message(FATAL_ERROR "Android PluginKit requires ANDROID_STL=c++_shared (huxeruiStl=c++_shared in gradle.properties)")
    endif()
    if (NOT HUXERUI_ANDROID_STATIC_LIBRARY OR NOT EXISTS "${HUXERUI_ANDROID_STATIC_LIBRARY}")
        message(FATAL_ERROR "Android PluginKit requires an installed HuxerUI SDK with its Android static archive")
    endif()
    get_target_property(includes HuxerUI::huxerui INTERFACE_INCLUDE_DIRECTORIES)
    add_library(hpk_android_archive STATIC IMPORTED GLOBAL)
    set_target_properties(hpk_android_archive PROPERTIES
        IMPORTED_LOCATION "${HUXERUI_ANDROID_STATIC_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${includes}")
    file(SHA256 "${HUXERUI_ANDROID_STATIC_LIBRARY}" archive_digest)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${HUXERUI_ANDROID_STATIC_LIBRARY}")
    string(SUBSTRING "${archive_digest}" 0 24 archive_identity)
    set_property(GLOBAL PROPERTY HPK_ANDROID_RUNTIME_ID "${archive_identity}-${CMAKE_ANDROID_NDK_VERSION}-${ANDROID_ABI}")
    file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/hpk-runtime.cpp"
        CONTENT "// Shared owner of the SDK archive's application and task state.\n")
    add_library(hpk_runtime SHARED "${CMAKE_CURRENT_BINARY_DIR}/hpk-runtime.cpp")
    # Resolve framework RTTI to the same address in the runtime, host, and dynamically loaded plugins.
    target_link_options(hpk_runtime PRIVATE "LINKER:-z,global")
    target_link_libraries(hpk_runtime PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,hpk_android_archive>" android EGL GLESv2 log)
    target_include_directories(hpk_runtime PUBLIC "${includes}")
    # Whole-archive retention lets independently built plugins use SDK functions absent from host code.
    set_target_properties(hpk_runtime PROPERTIES OUTPUT_NAME hpk_runtime)
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _hpk_android_rebind_all)
endfunction()

function(_hpk_android_plugin_runtime sdk)
    if (TARGET hpk_runtime)
        return()
    endif()
    if (NOT ANDROID_STL STREQUAL "c++_shared")
        message(FATAL_ERROR "Android plugins require ANDROID_STL=c++_shared")
    endif()
    set(runtime "${sdk}/runtime/${ANDROID_ABI}/libhpk_runtime.so")
    if (NOT EXISTS "${runtime}")
        message(FATAL_ERROR "Published host SDK runtime is missing: ${runtime}")
    endif()
    add_library(hpk_runtime SHARED IMPORTED GLOBAL)
    set_target_properties(hpk_runtime PROPERTIES IMPORTED_LOCATION "${runtime}")
    get_target_property(includes HuxerUI::huxerui INTERFACE_INCLUDE_DIRECTORIES)
    set_target_properties(hpk_runtime PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${includes}")
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _hpk_android_rebind_all)
endfunction()

function(_hpk_android_host_tool)
    if (TARGET hpk)
        return()
    endif()
    if (DEFINED ENV{HPK_HOST_TOOL})
        add_executable(hpk IMPORTED GLOBAL)
        set_target_properties(hpk PROPERTIES IMPORTED_LOCATION "$ENV{HPK_HOST_TOOL}")
        return()
    endif()
    get_filename_component(kit "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    if (CMAKE_HOST_WIN32)
        set(platform windows)
        set(name hpk.exe)
    elseif (CMAKE_HOST_APPLE)
        set(platform macos)
        set(name hpk)
    else()
        set(platform linux)
        set(name hpk)
    endif()
    file(MAKE_DIRECTORY "${kit}/.huxerui")
    file(LOCK "${kit}/.huxerui/host-tool.lock" GUARD FUNCTION TIMEOUT 180)
    set(cache "${kit}/.huxerui/host-tools")
    set(project "${cache}/native")
    file(MAKE_DIRECTORY "${cache}")
    if(NOT EXISTS "${project}/CMakeLists.txt")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env "HUXERUI_HOME=${HUXERUI_HOME}"
            huxerui create app native --platform "${platform}" --id org.huxerui.pluginkit.tools --agent none
            WORKING_DIRECTORY "${cache}" COMMAND_ERROR_IS_FATAL ANY)
    elseif(NOT EXISTS "${project}/platform/${platform}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env "HUXERUI_HOME=${HUXERUI_HOME}"
            huxerui platform add "${platform}" WORKING_DIRECTORY "${project}"
            COMMAND_ERROR_IS_FATAL ANY)
    endif()
    # Mark the tool project as an application so CLI does not select a library's preview example.
    set(tool_project [=[cmake_minimum_required(VERSION 3.24)
if(HUXERUI_PROJECT_PLAN_OUTPUT)
    file(WRITE "${HUXERUI_PROJECT_PLAN_OUTPUT}" "{\"schema\":1,\"kind\":\"app\",\"name\":\"PluginKit Tools\",\"id\":\"org.huxerui.pluginkit.tools\",\"target\":\"hpk\"}")
endif()
if(HUXERUI_PROJECT_PLAN_ONLY)
    return()
endif()
project(PluginKitHostTools LANGUAGES NONE)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
add_subdirectory("@kit@" kit)
]=])
    string(CONFIGURE "${tool_project}" tool_project @ONLY)
    file(CONFIGURE OUTPUT "${project}/CMakeLists.txt" CONTENT "${tool_project}" @ONLY)
    # CLI supplies the native host compiler environment, independently of the NDK toolchain.
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "HUXERUI_HOME=${HUXERUI_HOME}"
        huxerui build "${platform}" --config release WORKING_DIRECTORY "${project}"
        COMMAND_ERROR_IS_FATAL ANY)
    file(GLOB candidates "${project}/.huxerui/build/home-*/${platform}*/release/${name}")
    if (NOT candidates)
        message(FATAL_ERROR "Native hpk was not produced by huxerui build ${platform}")
    endif()
    set(latest 0)
    foreach(candidate IN LISTS candidates)
        file(TIMESTAMP "${candidate}" timestamp "%s")
        if (timestamp GREATER_EQUAL latest)
            set(program "${candidate}")
            set(latest "${timestamp}")
        endif()
    endforeach()
    add_executable(hpk IMPORTED GLOBAL)
    set_target_properties(hpk PROPERTIES IMPORTED_LOCATION "${program}")
endfunction()
