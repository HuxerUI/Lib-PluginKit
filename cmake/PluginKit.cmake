if (CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    cmake_minimum_required(VERSION 3.24)
    if (DEFINED _HPK_SDK_DIRECTORY)
        file(STRINGS "${_HPK_SDK_FILES}" headers ENCODING UTF-8)
        set(published "${_HPK_SDK_DIRECTORY}/.hpk-sdk-files")
        foreach (header IN LISTS headers)
            if (NOT EXISTS "${_HPK_SDK_SOURCE}/${header}")
                message(FATAL_ERROR "SDK output is missing: ${_HPK_SDK_SOURCE}/${header}")
            endif ()
        endforeach ()
        # Remove old paths before copying so a case-only rename replaces the old filename.
        if (EXISTS "${published}")
            file(STRINGS "${published}" previous ENCODING UTF-8)
            foreach (header IN LISTS previous)
                # The published file list only owns relative paths under the SDK directory.
                if (NOT header IN_LIST headers AND NOT IS_ABSOLUTE "${header}" AND
                        NOT header MATCHES "(^|/)[.][.](/|$)")
                    file(REMOVE "${_HPK_SDK_DIRECTORY}/${header}")
                endif ()
            endforeach ()
        endif ()
        foreach (header IN LISTS headers)
            set(destination "${_HPK_SDK_DIRECTORY}/${header}")
            get_filename_component(parent "${destination}" DIRECTORY)
            file(MAKE_DIRECTORY "${parent}")
            file(COPY_FILE "${_HPK_SDK_SOURCE}/${header}" "${destination}" ONLY_IF_DIFFERENT)
        endforeach ()
        file(COPY_FILE "${_HPK_SDK_FILES}" "${published}" ONLY_IF_DIFFERENT)
    elseif (DEFINED _HPK_PACKAGE_DIRECTORY)
        # Record completed package targets even when CMake reuses its configuration.
        set(invocation "$ENV{HPK_PACK_INVOCATION}")
        if (invocation MATCHES "^[0-9a-f]+$")
            file(TOUCH "${_HPK_PACKAGE_DIRECTORY}.hpk-${invocation}")
        endif ()
    endif ()
    return()
endif ()

include_guard(GLOBAL)

if (ANDROID)
    include("${CMAKE_CURRENT_LIST_DIR}/PluginKitAndroid.cmake")
endif()

function(_hpk_package_target output)
    string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" architecture)
    if (CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_OSX_ARCHITECTURES)
        list(LENGTH CMAKE_OSX_ARCHITECTURES architecture_count)
        if (NOT architecture_count EQUAL 1)
            message(FATAL_ERROR "Build each PluginKit macOS package with a single CMAKE_OSX_ARCHITECTURES value")
        endif ()
        string(TOLOWER "${CMAKE_OSX_ARCHITECTURES}" architecture)
    endif ()
    if (architecture STREQUAL "amd64")
        set(architecture x86_64)
    elseif (architecture STREQUAL "arm64")
        set(architecture aarch64)
    endif ()
    if (ANDROID AND ANDROID_ABI MATCHES "^(arm64-v8a|x86_64)$")
        set(${output} "android-${ANDROID_ABI}" PARENT_SCOPE)
    elseif (WIN32 AND MSVC AND CMAKE_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "x64")
        set(${output} windows-x86_64-msvc PARENT_SCOPE)
    elseif (CMAKE_SYSTEM_NAME STREQUAL "Linux" AND architecture MATCHES "^(x86_64|aarch64)$"
            AND CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(${output} "linux-${architecture}-gnu" PARENT_SCOPE)
    elseif (CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND architecture MATCHES "^(x86_64|aarch64)$"
            AND CMAKE_SIZEOF_VOID_P EQUAL 8)
        if (architecture STREQUAL "aarch64")
            set(architecture arm64)
        endif ()
        set(${output} "macos-${architecture}" PARENT_SCOPE)
    else ()
        message(FATAL_ERROR "PluginKit targets Windows x64 (MSVC), Linux x86_64/aarch64 (glibc), macOS x86_64/arm64, and Android arm64-v8a/x86_64")
    endif ()
endfunction()

function(_hpk_set_abi target)
    if (ANDROID)
        get_property(runtime_id GLOBAL PROPERTY HPK_ANDROID_RUNTIME_ID)
        target_compile_definitions(${target} PRIVATE "HPK_SDK_ABI=\"android-${runtime_id}-$<IF:$<CONFIG:Debug>,debug,release>\"")
        return()
    endif()
    target_compile_definitions(${target} PRIVATE
        "HPK_SDK_ABI=\"$<IF:$<CONFIG:Debug>,debug,release>-${HuxerUI_VERSION}\"")
endfunction()

# Publish the selected public headers and the bindings for their marked interfaces.
function(hpk_add_sdk target)
    if (HUXERUI_LIBRARY_GRAPH_ONLY)
        return()
    endif ()
    cmake_parse_arguments(PARSE_ARGV 1 SDK "" "BASE_DIRECTORY;OUTPUT_DIRECTORY" "HEADERS;CLANG_OPTIONS")
    if (SDK_UNPARSED_ARGUMENTS OR SDK_KEYWORDS_MISSING_VALUES OR NOT DEFINED SDK_HEADERS)
        message(FATAL_ERROR "hpk_add_sdk requires HEADERS and accepts BASE_DIRECTORY, OUTPUT_DIRECTORY, and CLANG_OPTIONS")
    endif ()
    if (NOT TARGET hpk-abi-stamp AND NOT ANDROID)
        message(FATAL_ERROR "Acquire HuxerUI::PluginKit before calling hpk_add_sdk")
    endif ()
    set(entries)
    foreach (entry IN LISTS SDK_HEADERS)
        file(REAL_PATH "${entry}" absolute BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}")
        if (NOT EXISTS "${absolute}")
            message(FATAL_ERROR "PluginKit SDK input does not exist: ${absolute}")
        endif ()
        list(APPEND entries "${absolute}")
    endforeach ()
    if (DEFINED SDK_BASE_DIRECTORY)
        file(REAL_PATH "${SDK_BASE_DIRECTORY}" base BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}")
    else ()
        file(REAL_PATH "${CMAKE_CURRENT_SOURCE_DIR}" base)
        list(LENGTH entries entry_count)
        if (entry_count EQUAL 1 AND IS_DIRECTORY "${entries}")
            set(base "${entries}")
        endif ()
    endif ()
    if (NOT IS_DIRECTORY "${base}")
        message(FATAL_ERROR "PluginKit SDK base directory does not exist: ${base}")
    endif ()
    if (SDK_OUTPUT_DIRECTORY)
        get_filename_component(directory "${SDK_OUTPUT_DIRECTORY}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    else ()
        set(directory "${CMAKE_CURRENT_BINARY_DIR}/plugin-sdk/${target}/$<CONFIG>")
    endif ()
    file(REAL_PATH "${directory}" resolved_output)
    if (resolved_output STREQUAL base)
        message(FATAL_ERROR "The SDK output directory must be separate from BASE_DIRECTORY")
    endif ()

    set(work "${CMAKE_CURRENT_BINARY_DIR}/hpk/${target}/$<CONFIG>")
    set(sources)
    foreach (entry IN LISTS entries)
        if (IS_DIRECTORY "${entry}")
            cmake_path(IS_PREFIX entry "${work}" NORMALIZE work_in_entry)
            cmake_path(IS_PREFIX entry "${directory}" NORMALIZE output_in_entry)
            if (work_in_entry OR output_in_entry)
                message(FATAL_ERROR "SDK output overlaps the scanned header directory ${entry}")
            endif ()
            file(GLOB_RECURSE headers CONFIGURE_DEPENDS "${entry}/*.h" "${entry}/*.hh" "${entry}/*.hpp" "${entry}/*.hxx")
            list(APPEND sources ${headers})
        else ()
            list(APPEND sources "${entry}")
        endif ()
    endforeach ()

    set(module "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
    get_filename_component(kit "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    file(GLOB_RECURSE kit_headers CONFIGURE_DEPENDS RELATIVE "${kit}/include" "${kit}/include/huxerui/*.h")
    set(kit_inputs "${module}")
    set(outputs "${directory}/PluginKit.cmake" "${directory}/cpp-abi.txt")
    foreach (header IN LISTS kit_headers)
        list(APPEND kit_inputs "${kit}/include/${header}")
        list(APPEND outputs "${directory}/${header}")
    endforeach ()
    set(reserved_paths ${kit_headers} PluginKit.cmake cpp-abi.txt .hpk-sdk-files)
    if(ANDROID)
        list(APPEND reserved_paths PluginKitAndroid.cmake)
        list(APPEND kit_inputs "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/PluginKitAndroid.cmake")
        list(APPEND outputs "${directory}/PluginKitAndroid.cmake" "${directory}/runtime/${ANDROID_ABI}/libhpk_runtime.so")
    endif()
    if (CMAKE_HOST_WIN32)
        list(TRANSFORM reserved_paths TOLOWER)
    endif ()
    set(sdk_inputs)
    foreach (path IN LISTS sources)
        file(REAL_PATH "${path}" source)
        list(APPEND sdk_inputs "${source}")
    endforeach ()
    list(REMOVE_DUPLICATES sdk_inputs)
    list(SORT sdk_inputs)
    set(sdk_headers)
    foreach (source IN LISTS sdk_inputs)
        cmake_path(IS_PREFIX base "${source}" NORMALIZE in_base)
        if (NOT in_base)
            message(FATAL_ERROR "SDK header ${source} is outside BASE_DIRECTORY ${base}")
        endif ()
        cmake_path(RELATIVE_PATH source BASE_DIRECTORY "${base}" OUTPUT_VARIABLE header)
        set(key "${header}")
        if (CMAKE_HOST_WIN32)
            string(TOLOWER "${key}" key)
        endif ()
        list(FIND reserved_paths "${key}" reserved_index)
        if (NOT reserved_index EQUAL -1)
            list(LENGTH kit_headers kit_header_count)
            if (reserved_index LESS kit_header_count)
                list(GET kit_headers ${reserved_index} kit_header)
                message(FATAL_ERROR "SDK path ${header} is shared by ${source} and ${kit}/include/${kit_header}")
            endif ()
            message(FATAL_ERROR "SDK path ${header} is shared by ${source} and the PluginKit SDK publisher")
        endif ()
        list(APPEND sdk_headers "${header}")
    endforeach ()
    # Changing the header list, including removing its last entry, invalidates the scan.
    set(header_list "${work}/headers.txt")
    string(REPLACE ";" "\n" header_names "${sdk_headers}")
    file(GENERATE OUTPUT "${header_list}" CONTENT "${header_names}\n" NEWLINE_STYLE UNIX)
    set(sdk_source "${base}")
    set(sdk_files "${header_list}")
    if (ANDROID)
        _hpk_android_host_tool()
        if (ANDROID_ABI STREQUAL "arm64-v8a")
            set(triple aarch64-linux-android)
        else()
            set(triple x86_64-linux-android)
        endif()
        set(android_options --target=${triple}${ANDROID_PLATFORM_LEVEL} --sysroot=${CMAKE_SYSROOT}
            -isystem "${CMAKE_SYSROOT}/usr/include/c++/v1" -isystem "${CMAKE_SYSROOT}/usr/include/${triple}")
        get_property(runtime_id GLOBAL PROPERTY HPK_ANDROID_RUNTIME_ID)
        list(APPEND android_options "-DHPK_SDK_ABI=\"android-${runtime_id}-$<IF:$<CONFIG:Debug>,debug,release>\"")
    endif()
    if (HPK_BUILD_GENERATOR)
        set(sdk_source "${work}/sdk")
        set(sdk_files "${sdk_source}/.hpk-sdk-files")
        set(framework_includes "$<TARGET_PROPERTY:HuxerUI::huxerui,INTERFACE_INCLUDE_DIRECTORIES>")
        add_custom_command(OUTPUT "${sdk_files}"
            COMMAND "$<TARGET_FILE:hpk>" gen "${base}" "${sdk_source}" "${header_list}" --
                "-I${kit}/include" "-I$<JOIN:${framework_includes},;-I>" ${SDK_CLANG_OPTIONS} ${android_options}
            DEPENDS hpk "${header_list}" ${sdk_inputs} ${kit_inputs}
            COMMAND_EXPAND_LISTS VERBATIM)
    endif ()

    if (ANDROID)
        get_target_property(stamp_includes HuxerUI::huxerui INTERFACE_INCLUDE_DIRECTORIES)
        list(TRANSFORM stamp_includes PREPEND "-I")
        set(stamp_command "$<TARGET_FILE:hpk>" abi "${directory}/cpp-abi.txt" -- "-I${kit}/include"
            ${stamp_includes} ${android_options})
        set(stamp_dependency hpk hpk_runtime)
        set(runtime_commands COMMAND "${CMAKE_COMMAND}" -E make_directory "${directory}/runtime/${ANDROID_ABI}"
            COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:hpk_runtime>" "${directory}/runtime/${ANDROID_ABI}/libhpk_runtime.so"
            COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/PluginKitAndroid.cmake" "${directory}/PluginKitAndroid.cmake")
    else()
        set(stamp_command "$<TARGET_FILE:hpk-abi-stamp>" "${directory}/cpp-abi.txt")
        set(stamp_dependency hpk-abi-stamp)
    endif()
    add_custom_command(OUTPUT ${outputs}
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${directory}"
        COMMAND "${CMAKE_COMMAND}" -E copy_directory "${kit}/include/huxerui" "${directory}/huxerui"
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${module}" "${directory}/PluginKit.cmake"
        COMMAND ${stamp_command}
        ${runtime_commands}
        DEPENDS ${stamp_dependency} ${kit_inputs}
        COMMAND_EXPAND_LISTS VERBATIM)
    # Reconcile the generated file list so a missing or obsolete binding is handled on incremental builds.
    add_custom_target(${target}-plugin-sdk
        COMMAND "${CMAKE_COMMAND}" "-D_HPK_SDK_DIRECTORY=${directory}" "-D_HPK_SDK_SOURCE=${sdk_source}"
            "-D_HPK_SDK_FILES=${sdk_files}" -P "${module}"
        DEPENDS ${outputs} "${sdk_files}"
        VERBATIM)
    add_dependencies(${target} ${target}-plugin-sdk)
    target_include_directories(${target} PRIVATE "${directory}")
    set_target_properties(${target} PROPERTIES HPK_SDK_DIRECTORY "${directory}")
    set_property(TARGET ${target} PROPERTY HPK_CLANG_OPTIONS ${SDK_CLANG_OPTIONS} ${android_options})
endfunction()

# Attach Android's common runtime and native bootstrap without requiring Service execution.
function(hpk_use_runtime target)
    if (ANDROID AND NOT HUXERUI_LIBRARY_GRAPH_ONLY)
        _hpk_android_runtime()
        target_link_libraries(${target} PRIVATE hpk_runtime hpk_android)
        _hpk_set_abi(${target})
    endif()
endfunction()

# Stage desktop workers or enable Android Service support, including the common runtime.
function(hpk_use_worker target)
    if (HUXERUI_LIBRARY_GRAPH_ONLY)
        return()
    endif ()
    if (ANDROID)
        hpk_use_runtime(${target})
        return()
    endif()
    if (WIN32)
        set(destination .)
    elseif (APPLE)
        set(destination MacOS)
    else ()
        set(destination bin)
    endif ()
    set(output "$<TARGET_FILE_DIR:${target}>")
    set(copy_runtime)
    if (WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
        list(APPEND copy_runtime COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:HuxerUI::huxerui>" "${output}")
    endif ()
    add_custom_target(${target}-plugin-worker
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${output}"
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:hpk-worker>" "${output}"
        ${copy_runtime}
        DEPENDS hpk-worker HuxerUI::huxerui
        VERBATIM)
    add_dependencies(${target} ${target}-plugin-worker)
    huxerui_add_runtime_dependencies(${target} FILES "$<TARGET_FILE:hpk-worker>" DESTINATION "${destination}")
    huxerui_add_runtime_dependencies(${target} TARGETS HuxerUI::huxerui)
endfunction()

# Attach the published SDK and an installable package to an existing library target.
function(hpk_add_plugin target)
    cmake_parse_arguments(PARSE_ARGV 1 PLUGIN "" "SDK;MANIFEST;RESOURCE_ROOT;RESOURCE_NAMESPACE" "")
    if (PLUGIN_UNPARSED_ARGUMENTS OR PLUGIN_KEYWORDS_MISSING_VALUES OR NOT PLUGIN_MANIFEST)
        message(FATAL_ERROR "hpk_add_plugin requires MANIFEST and accepts SDK, RESOURCE_ROOT, and RESOURCE_NAMESPACE")
    endif ()
    if (NOT TARGET ${target})
        message(FATAL_ERROR "Create the plugin library target ${target} before calling hpk_add_plugin")
    endif ()
    get_target_property(kind ${target} TYPE)
    get_target_property(imported ${target} IMPORTED)
    get_target_property(alias ${target} ALIASED_TARGET)
    if (imported OR alias OR NOT kind MATCHES "^(SHARED|MODULE)_LIBRARY$")
        message(FATAL_ERROR "hpk_add_plugin requires a buildable shared or module library target")
    endif ()
    if ((PLUGIN_RESOURCE_ROOT AND NOT PLUGIN_RESOURCE_NAMESPACE) OR (PLUGIN_RESOURCE_NAMESPACE AND NOT PLUGIN_RESOURCE_ROOT))
        message(FATAL_ERROR "hpk_add_plugin requires RESOURCE_ROOT and RESOURCE_NAMESPACE together")
    endif ()
    _hpk_package_target(package_target)
    if (PLUGIN_SDK)
        get_filename_component(sdk "${PLUGIN_SDK}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    else ()
        set(sdk "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    endif ()
    set(abi_stamp "${sdk}/cpp-abi.txt")
    file(READ "${abi_stamp}" cpp_abi)
    if (NOT cpp_abi MATCHES "^[0-9A-Za-z.+:=_-]+$")
        message(FATAL_ERROR "The published PluginKit SDK has an invalid C++ ABI stamp: ${abi_stamp}")
    endif ()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${abi_stamp}")

    set(package_dir "${CMAKE_BINARY_DIR}/packages/${target}/$<CONFIG>")
    set(work "${CMAKE_CURRENT_BINARY_DIR}/hpk/${target}/$<CONFIG>/package")
    target_include_directories(${target} PRIVATE "${sdk}")
    target_compile_features(${target} PRIVATE cxx_std_20)
    if (ANDROID)
        _hpk_android_plugin_runtime("${sdk}")
        target_link_libraries(${target} PRIVATE hpk_runtime)
        string(REGEX REPLACE ":libc[+][+]=.*$" "" runtime_abi "${cpp_abi}")
        string(REGEX REPLACE "-(debug|release)$" "" runtime_base "${runtime_abi}")
        if(CMAKE_BUILD_TYPE)
            if(CMAKE_BUILD_TYPE STREQUAL "Debug")
                set(expected_config debug)
            else()
                set(expected_config release)
            endif()
            if(NOT runtime_abi STREQUAL "${runtime_base}-${expected_config}")
                message(FATAL_ERROR "Build the Android plugin with the same configuration as its published host SDK")
            endif()
        endif()
        target_compile_definitions(${target} PRIVATE "HPK_SDK_ABI=\"${runtime_base}-$<IF:$<CONFIG:Debug>,debug,release>\"")
    else()
        target_link_libraries(${target} PRIVATE HuxerUI::huxerui)
        _hpk_set_abi(${target})
    endif()
    set_target_properties(${target} PROPERTIES HPK_PACKAGE_DIRECTORY "${package_dir}")
    if (WIN32)
        target_compile_options(${target} PRIVATE /utf-8)
        target_compile_definitions(${target} PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
    else ()
        find_package(Threads REQUIRED)
        target_link_libraries(${target} PRIVATE Threads::Threads)
    endif ()

    set(manifest "${CMAKE_CURRENT_BINARY_DIR}/${target}.json")
    set(generated_manifest "${work}/plugin.json")
    configure_file("${PLUGIN_MANIFEST}" "${manifest}" @ONLY)
    file(GENERATE OUTPUT "${generated_manifest}" INPUT "${manifest}")

    set(resource_plan "${work}/resource-package.txt")
    set(staged_index)
    set(remove_resources)
    if (PLUGIN_RESOURCE_ROOT)
        huxerui_add_resources(${target} ROOT "${PLUGIN_RESOURCE_ROOT}" NAMESPACE "${PLUGIN_RESOURCE_NAMESPACE}")
    endif ()
    get_target_property(resource_package ${target} HUXERUI_RESOURCE_PACKAGE)
    if (resource_package)
        set(resource_index "${resource_package}/huxerui/resources.bin")
        set(staged_index "${package_dir}/resources/huxerui/resources.bin")
        add_custom_command(OUTPUT "${staged_index}"
            COMMAND "${CMAKE_COMMAND}" -E rm -rf "${package_dir}/resources"
            COMMAND "${CMAKE_COMMAND}" -E copy_directory "${resource_package}" "${package_dir}/resources"
            DEPENDS "${resource_index}" "${resource_plan}" VERBATIM)
    else ()
        set(resource_package "")
        set(remove_resources COMMAND "${CMAKE_COMMAND}" -E rm -rf "${package_dir}/resources")
    endif ()
    # A changed resource option also restages the bundle when the plugin library has not changed.
    file(GENERATE OUTPUT "${resource_plan}" CONTENT "${resource_package}\n")
    set(staged_manifest "${package_dir}/plugin.json")
    set(staged_module "${package_dir}/plugin${CMAKE_SHARED_LIBRARY_SUFFIX}")
    add_custom_command(OUTPUT "${staged_manifest}" "${staged_module}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${package_dir}"
        ${remove_resources}
        COMMAND "${CMAKE_COMMAND}" -E copy "${generated_manifest}" "${staged_manifest}"
        COMMAND "${CMAKE_COMMAND}" -E copy "$<TARGET_FILE:${target}>" "${staged_module}"
        DEPENDS ${target} ${staged_index} "${generated_manifest}" "${resource_plan}" VERBATIM)
    add_custom_target(${target}-package ALL
        COMMAND "${CMAKE_COMMAND}" "-D_HPK_PACKAGE_DIRECTORY=${package_dir}" -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
        DEPENDS "${staged_manifest}" "${staged_module}" VERBATIM)
    if(ANDROID AND HUXERUI_ANDROID_APP_INTEGRATION_ROOT)
        get_property(registered GLOBAL PROPERTY HPK_ANDROID_PACKAGE_TARGETS)
        set_property(GLOBAL APPEND PROPERTY HPK_ANDROID_PACKAGE_TARGETS "${target}")
        if(NOT registered)
            cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _hpk_android_package_plan)
        endif()
    endif()
endfunction()
