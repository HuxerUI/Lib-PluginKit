{
  "schema_version": 1,
  "id": "@plugin_id@",
  "version": "@plugin_version@",
  "target": "@package_target@",
  "execution_modes": ["in_process", "worker_process"],
  "cpp_abi": "@cpp_abi@",
  "extensions": [
    {"point": "example.table-importers", "metadata": {"extensions": [".csv"]}},@secondary_importer@
    {"point": "example.table-exporters", "metadata": {"extensions": [".csv"]}}
  ],
  "settings": [
    {
      "key": "max_rows",
      "type": "integer",
      "title": {"resource": "csv_resources:strings/settings_max_rows"},
      "description": "Count data rows after the header.",
      "default": 10000,
      "minimum": 1,
      "maximum": 100000
    }
  ]
}
